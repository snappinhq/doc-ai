{
  "name": "@snappinhq/doc-ai",
  "version": "1.1.9",
  "description": "PDF → Structured JSON Data",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "pdf",
    "document-ai",
    "invoice",
    "extraction",
    "llm"
  ],
  "author": "snappinhq",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@ai-sdk/google-vertex": "^4.0.80",
    "@aws-sdk/client-textract": "^3.1003.0",
    "ai": "^6.0.116",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "dotenv": "^17.3.1",
    "tsup": "^8.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
